# Kopieren nach .env (wird nie committet). In der Claude-Cloud-Umgebung
# setzt der Proxy den API-Football-Header automatisch, dann leer lassen.
API_FOOTBALL_KEY=
API_FOOTBALL_PER_MINUTE=10
API_FOOTBALL_DAILY_RESERVE=5
# Standard: sqlite:///storage/fussball.db ; später z. B. postgresql+psycopg://user:pw@host/db
DATABASE_URL=
TELEGRAM_TOKEN=
